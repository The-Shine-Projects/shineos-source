[Icon Theme]
Name=StarlightOS Icons
Comment=StarlightOS default icon theme
Inherits=Adwaita
Example=folder

Directories=apps,devices,places,mimetypes

[apps]
Size=64
Context=Applications
Type=Scalable
MinSize=16
MaxSize=512

[devices]
Size=64
Context=Devices
Type=Scalable
MinSize=16
MaxSize=512

[places]
Size=64
Context=Places
Type=Scalable
MinSize=16
MaxSize=512

[mimetypes]
Size=64
Context=MimeTypes
Type=Scalable
MinSize=16
MaxSize=512
