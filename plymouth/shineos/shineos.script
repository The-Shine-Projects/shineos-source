Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

bg_raw = Image("background.png");
img_w = bg_raw.GetWidth();
img_h = bg_raw.GetHeight();

# Chọn tỉ lệ sao cho ảnh phủ kín màn
sx = screen_w / img_w;
sy = screen_h / img_h;
if (sx > sy)
  s = sx;
else
  s = sy;

new_w = img_w * s;
new_h = img_h * s;

bg_image = bg_raw.Scale(new_w, new_h);
bg_sprite = Sprite(bg_image);
bg_sprite.SetX((screen_w - new_w) / 2);
bg_sprite.SetY((screen_h - new_h) / 2);
bg_sprite.SetZ(-100);
